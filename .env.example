# Reference only. Do not copy this file by hand: scripts/init-env.sh creates .env
# with random secrets. Every variable the stack reads is listed here.
# The secrets are empty on purpose: compose refuses to start without them.

# --- Secrets (generated by scripts/init-env.sh) ---
# Must start with sk-
LITELLM_MASTER_KEY=
# Encrypts provider keys stored in the database. Never change it after the first start.
LITELLM_SALT_KEY=
# Must start with sk-
OPENWEBUI_LITELLM_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
WEBUI_SECRET_KEY=

# --- Budgets in USD (scripts/bootstrap.py). 30d and 1mo reset monthly, on the 1st ---
USER_BUDGET_USD=20
USER_BUDGET_PERIOD=30d
OPENWEBUI_BUDGET_USD=500
OPENWEBUI_BUDGET_PERIOD=30d

# --- Open WebUI ---
WEBUI_URL=http://localhost:3000
# OPEN_WEBUI_PORT=3000
# LiteLLM model name Open WebUI uses for document embeddings (compose.yaml)
# RAG_EMBEDDING_MODEL=embedding
# Chat retention for scripts/purge-chats.sh, whole number of days, 1 or more
# CHAT_RETENTION_DAYS=90

# --- LiteLLM ---
# Host port (compose.yaml). bootstrap.py and the tests use it to build LITELLM_URL.
# LITELLM_PORT=4000
# Only if LiteLLM is not on localhost:LITELLM_PORT (bootstrap.py, tests)
# LITELLM_URL=http://localhost:4000

# --- Versions (pinned defaults in compose.yaml) ---
# LITELLM_VERSION=v1.105.1
# OPEN_WEBUI_VERSION=v0.12.2

# --- Docker Compose ---
# Overlay list, so every docker compose command uses the same files
# COMPOSE_FILE=compose.yaml:compose.tls.yaml
# Project name; volume names start with it (default llm-gateway from compose.yaml)
# COMPOSE_PROJECT_NAME=llm-gateway

# --- Tests (compose.test.yaml, tests/) ---
# MOCK_LLM_PORT=8000
# MOCK_LLM_URL=http://localhost:8000

# --- HTTPS (compose.tls.yaml) ---
# DOMAIN=chat.example.com

# --- Entra ID SSO (compose.entra.yaml) ---
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CLIENT_TENANT_ID=
# ENTRA_ROLE_MANAGEMENT=false
# ENTRA_MERGE_BY_EMAIL=false
# ENABLE_LOGIN_FORM=true

# --- Provider keys: only the ones in litellm/models.yaml (see examples/providers/) ---
MISTRAL_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=https://<resource>.openai.azure.com/
# AZURE_API_VERSION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# VERTEX_PROJECT=
# VERTEX_CREDENTIALS=/app/vertex-sa.json
# OPENAI_EU_API_KEY=
# STACKIT_AI_TOKEN=
# IONOS_API_TOKEN=
# OVHCLOUD_API_KEY=
# SCW_SECRET_KEY=
# TSYSTEMS_LLMHUB_API_KEY=
# VLLM_API_BASE=
